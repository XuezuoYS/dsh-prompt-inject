{
  "name": "@xuezuoys/dsh-prompt-inject",
  "version": "0.3.0",
  "description": "这是一个适用于 Deepseek Harness 的插件，向用户提供 GUI 下分组的自定义且区分模型的发送 Prompt 注入功能。",
  "type": "module",
  "main": "lib/index.js",
  "icon": "./icon.svg",
  "scripts": {
    "test": "node tests/run.mjs a",
    "test:host": "node tests/run.mjs b",
    "test:all": "node tests/run.mjs all"
  },
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./locale/zh.json": "./locale/zh.json",
    "./locale/en.json": "./locale/en.json",
    "./package.json": "./package.json"
  },
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings"
      ]
    }
  },
  "engines": {
    "dsh": ">=0.2.1-rc.2 <0.3.0"
  },
  "meta": {
    "title": "@xuezuoys/dsh-prompt-inject",
    "description": "在设置页按组与模型自定义发送前后缀和 system 注入"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.5",
    "@deepseek-ai/dsh-atomic-write": "0.2.1-rc.2",
    "@deepseek-ai/dsh-client-ui-primitives": "0.2.1-rc.2",
    "@deepseek-ai/dsh-home-paths": "0.2.1-rc.2",
    "@deepseek-ai/dsh-llm": "0.2.1-rc.2",
    "@deepseek-ai/dsh-session": "0.2.1-rc.2",
    "@deepseek-ai/dsh-system-prompt": "0.2.1-rc.2"
  },
  "author": "xuezuoys",
  "homepage": "https://github.com/XuezuoYS/dsh-prompt-inject",
  "repository": "XuezuoYS/dsh-prompt-inject",
  "keywords": [
    "deepseek-harness",
    "dsh",
    "cordis",
    "plugin",
    "prompt",
    "prompt-injection",
    "system-prompt"
  ],
  "files": [
    "lib",
    "locale",
    "icon.svg",
    "cordis.patch.yml",
    "README.md"
  ],
  "license": "MIT"
}
