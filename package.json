{
  "name": "dsh-prompt-inject",
  "version": "0.2.0",
  "private": true,
  "description": "按注入点与模型作用域自定义发送时的前后缀与 system 注入",
  "type": "module",
  "main": "lib/index.js",
  "icon": "./icon.svg",
  "scripts": {
    "test": "node .agents/checks/run.mjs a",
    "test:host": "node .agents/checks/run.mjs b",
    "test:all": "node .agents/checks/run.mjs all"
  },
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./locale/zh.json": "./locale/zh.json",
    "./locale/en.json": "./locale/en.json",
    "./package.json": "./package.json"
  },
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings"
      ]
    }
  },
  "engines": {
    "dsh": "0.2.1-rc.2"
  },
  "meta": {
    "title": "dsh-prompt-inject",
    "description": "在设置页按注入点与模型自定义发送前后缀和 system 注入"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.5",
    "@deepseek-ai/dsh-atomic-write": "0.2.1-rc.2",
    "@deepseek-ai/dsh-client-ui-primitives": "0.2.1-rc.2",
    "@deepseek-ai/dsh-home-paths": "0.2.1-rc.2",
    "@deepseek-ai/dsh-llm": "0.2.1-rc.2",
    "@deepseek-ai/dsh-session": "0.2.1-rc.2",
    "@deepseek-ai/dsh-system-prompt": "0.2.1-rc.2"
  },
  "files": [
    "lib",
    "locale",
    "icon.svg",
    "cordis.patch.yml",
    "README.md"
  ],
  "license": "MIT"
}
